# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram Bot ─────────────────────────────────────────────────────────
# Bot token from @BotFather — server-side ONLY, never exposed to client
TELEGRAM_BOT_TOKEN=
# Username of your Telegram bot (public, used in Mini App links)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Secret for Telegram webhook verification
TELEGRAM_WEBHOOK_SECRET=
# Maximum age (seconds) for Telegram initData before it's considered expired
# Default: 86400 (24 hours)
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# ── Development Authentication ───────────────────────────────────────────
# Enable dev auth mode (only works when NODE_ENV !== 'production')
VIBE_DEV_AUTH_ENABLED=false
# Dev Telegram user ID — must be a valid positive integer
VIBE_DEV_TELEGRAM_USER_ID=
VIBE_DEV_TELEGRAM_FIRST_NAME=Dev User
VIBE_DEV_TELEGRAM_USERNAME=dev_user

# ── App ───────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=http://localhost:3000
