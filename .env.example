# Supabase (required for app boot, auth, and realtime)
# Use the NON-PUBLIC names on the server and the NEXT_PUBLIC_* names in the browser.
# The app code accepts both conventions so you can match whichever hosting
# platform you deploy to (Vercel, Netlify, Railway, etc.).

# REQUIRED: Project URL from Supabase → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co  # browser-facing alias (same value)

# REQUIRED: Anon/public key from Supabase → Settings → API
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_PUBLISHABLE_KEY=<anon-key>  # alias
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>  # browser-facing alias

# OPTIONAL: Service-role / secret key from Supabase → Settings → API
# NEVER expose this in the browser. Used only server-side (admin client,
# server actions, webhooks, edge functions).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_SECRET_KEY=<service-role-key>

# Telegram Mini App
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_BOT_USERNAME=vibe_app_bot
TELEGRAM_MINI_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=vibe_app_bot

# Optional overrides (most projects do not need these)
NEXT_PUBLIC_AI_TRANSLATION_ENABLED=true
NEXT_PUBLIC_AI_PROVIDER_KEY=<provider-key>
NEXT_PUBLIC_AI_TRANSLATION_PROVIDER=internal
NEXT_PUBLIC_DEV_AUTH=false
VIBE_DEV_AUTH_ENABLED=false
VIBE_DEV_TELEGRAM_USER_ID=0
VIBE_DEV_TELEGRAM_FIRST_NAME=Dev
VIBE_DEV_TELEGRAM_USERNAME=dev_user
VIBE_DEV_TELEGRAM_LAST_NAME=
LOG_LEVEL=info
